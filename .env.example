# Obsyd environment variables
#
# Copy this file to .env for local development.
# Never commit your real .env with production credentials.

# Required: Neon/PostgreSQL connection string.
# Local/dev example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/obsyd?sslmode=disable
#
# Neon/Render example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Server host.
# Use 0.0.0.0 for Render/Docker and localhost if you want local-only binding.
HOST=0.0.0.0

# Server port.
# Render sets PORT automatically in production.
PORT=8000

# Runtime environment.
# Use production on Render so the session cookie receives the Secure flag.
NODE_ENV=development
